<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:property name="base_length" value="0.263"/>
    <xacro:property name="base_width" value="0.1635"/>
    <xacro:property name="base_height" value="0.12"/>
    <xacro:property name="base_mass" value="1.671"/>

    <xacro:property name="wheel_radius" value="0.035"/>
    <xacro:property name="wheel_length" value="0.04"/>
    <xacro:property name="wheel_mass" value="0.055"/>

    <xacro:property name="caster_wheel_radius" value="0.0175"/>
    <xacro:property name="caster_wheel_mass" value="0.020"/>
 

    <xacro:macro name="cuboid_link" params="prefix m l b h x y z r p yaw " >
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="${l} ${b} ${h}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
                <material name="green"/>
            </visual>
            <xacro:cuboid_collision lbh="${l} ${b} ${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
            <xacro:cuboid_inertia m="${m}" l="${l}" b="${b}" h="${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="cube_link" params="prefix m l b h x y z r p yaw " >
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="${l} ${b} ${h}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
                <material name="red"/>
            </visual>
            <xacro:cuboid_collision lbh="${l} ${b} ${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
            <xacro:cuboid_inertia m="${m}" l="${l}" b="${b}" h="${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="small_cuboid_link" params="prefix m l b h x y z r p yaw " >
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="${l} ${b} ${h}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
                <material name="grey"/>
            </visual>
            <xacro:cuboid_collision lbh="${l} ${b} ${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
            <xacro:cuboid_inertia m="${m}" l="${l}" b="${b}" h="${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
        </link>
    </xacro:macro>


    <xacro:macro name="wheel_link" params="prefix m r l x y z roll p yaw">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${r}" length="${l}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="blue"/>
            </visual>
            <xacro:cylinder_inertia m="${m}" r="${r}" l="${l}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
            <collision>
                <geometry>
                    <sphere radius="${r}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>


    <xacro:macro name="sphere_link" params="prefix m r x y z roll p yaw">
        <link name="${prefix}_sphere_link">
            <visual>
                <geometry>
                    <sphere radius="${r}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="yellow"/>
            </visual>
            <xacro:sphere_inertia m="${m}" r="${r}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
            <xacro:sphere_collision r="${r}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
        </link>
    </xacro:macro>


    <link name="odom"/>
    <joint name="odom_to_base_footprint" type="fixed">
        <parent link="odom"/>
        <child  link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
 
    
    
    
    <link name="base_footprint"/>

    <xacro:cuboid_link prefix="base" m="${base_mass}" l="${base_length}" b="${base_width}" h="${base_height}" x="0" y="0" z="${base_height/2}" r="0" p="0" yaw="0"/>

    <xacro:wheel_link prefix="front_right" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <xacro:wheel_link prefix="front_left" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <xacro:sphere_link prefix="rear_caster" m="${caster_wheel_mass}" r="${caster_wheel_radius}" x="0" y="0" z="0" roll="0" p="0" yaw="0"/>




    <joint name="base_footprint_base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0175" rpy="0 0 0"/>
    </joint>



    <joint name="base_front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel_link"/>
        <axis xyz="0 1 0"/>        
        <origin xyz="0.090391 ${-((0.171/2)+(wheel_length/2)+0.01125)} 0.0175" rpy="0 0 0"/>
    </joint>

    <joint name="base_front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel_link"/>
        <axis xyz="0 1 0"/>        
        <origin xyz="0.090391 ${((0.171/2)+(wheel_length/2)+0.01125)} 0.0175" rpy="0 0 0"/>
    </joint>

    <joint name="base_rear_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rear_caster_sphere_link"/>
        <origin xyz="-0.0655 0 0" rpy="0 0 0"/> 
    </joint>

    <gazebo reference="rear_caster_sphere_link">
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>


    <xacro:cube_link prefix="scan" m="0.186" l="0.0605" b="0.069" h="0.055" x="0" y="0" z="-0.0175" r="0" p="0" yaw="0"/>


    <joint  name="scan_joint" type="fixed">
        <origin xyz="0.0 0 ${0.12+0.045}" rpy="0 0 0"/>
        <child link="scan_link"/> 
        <parent link="base_link"/> 
    </joint>



</robot>

